@using ScottNeidig.Web.Models
@model HomeViewModel

@*
    Portfolio framing, not a pitch. This site is linked from a freelancer profile, so it
    describes the work and the track record and asks for nothing: no CTA, no contact details,
    no offer of future work. Voice is past tense and first person about work actually done.

    Claims have to be ones that survive a client conversation. No "hand-written" claim (he
    guides AI to write code; claiming hand-coded is false and the first thing a client
    interview would expose). Copy is Scott's to sharpen.
*@

<section class="section--lede">
    <div class="container">
        <p class="topper">Web and application developer</p>
        @* "since 2005" not "25 years": the resume backs the date, and About uses the same
           wording. Keep the two consistent. *@
        <h1 class="header">Building .NET applications since 2005</h1>
        <p class="text lede__text">
            I've built and maintained .NET applications, nopCommerce stores and business
            websites since 2005, a lot of it inside agencies. This site is a record of that
            work: what I built, what it runs on, and what I learned doing it.
        </p>
    </div>
</section>

<section class="section--alt">
    <div class="container">
        <p class="topper">What I do</p>
        <h2 class="title">The work I take on</h2>

        @* Each card links into its detail page. Order is nopCommerce first (best proof),
           .NET second (deepest experience), websites last. *@
        <ul class="offers">
            <li>
                <a class="offer" asp-controller="Services" asp-action="NopCommerce">
                    <h3 class="offer__title">nopCommerce development</h3>
                    <p class="offer__text">
                        Custom plugins, integrations, version upgrades and fixes on live
                        stores. Certified nopCommerce developer, agency background.
                    </p>
                    @* Decorative: the whole card is one link named by the h3, so this repeat
                       is hidden from screen readers to avoid announcing the title twice. *@
                    <span class="offer__more" aria-hidden="true">See the work</span>
                </a>
            </li>

            <li>
                <a class="offer" asp-controller="Services" asp-action="DotNet">
                    <h3 class="offer__title">.NET application development</h3>
                    <p class="offer__text">
                        Maintenance, fixes and new features on existing .NET systems, and new
                        builds on ASP.NET Core. The back end, not just the front.
                    </p>
                    <span class="offer__more" aria-hidden="true">See the work</span>
                </a>
            </li>

            <li>
                <a class="offer" asp-controller="Services" asp-action="SmallBusiness">
                    <h3 class="offer__title">Business websites</h3>
                    <p class="offer__text">
                        Fast, server-rendered sites that search engines can read on the first
                        pass. This one included.
                    </p>
                    <span class="offer__more" aria-hidden="true">See the work</span>
                </a>
            </li>
        </ul>
    </div>
</section>

@if (Model.FeaturedProjects.Count > 0)
{
    <section>
        <div class="container">
            <p class="topper">Work</p>
            <h2 class="title">Selected work</h2>

            <ul class="cards">
                @foreach (var project in Model.FeaturedProjects)
                {
                    @* h3: the "Recent builds" h2 sits above this grid, so h2 here would skip
                       nothing but would flatten the outline. *@
                    <partial name="_ProjectCard" model="@(new ProjectCardModel
                            {
                                Project = project,
                                HeadingLevel = 3
                            })" />
                }
            </ul>

            <p class="cards__more">
                <a asp-controller="Work" asp-action="Index">See all work</a>
            </p>
        </div>
    </section>
}

@if (Model.RecentPosts.Count > 0)
{
    <section class="section--alt">
        <div class="container">
            <p class="topper">Blog</p>
            <h2 class="title">Selected reading</h2>

            <ul class="cards">
                @foreach (var post in Model.RecentPosts)
                {
                    @* h3: the section h2 above the grid already occupies level 2, same as the
                       work cards, so the outline stays intact. *@
                    <partial name="_PostCard" model="@(new PostCardModel
                            {
                                Post = post,
                                HeadingLevel = 3
                            })" />
                }
            </ul>

            <p class="cards__more">
                <a asp-controller="Blog" asp-action="Index">Read the blog</a>
            </p>
        </div>
    </section>
}
