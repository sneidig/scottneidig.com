@using ScottNeidig.Web.Models
@model HomeViewModel

@*
    Portfolio framing, not a pitch. This site is linked from a freelancer profile, so it
    describes the work and the track record and asks for nothing: no CTA, no contact details,
    no offer of future work. Voice is past tense and first person about work actually done.

    Claims have to be ones that survive a client conversation. No "hand-written" claim (he
    guides AI to write code; claiming hand-coded is false and the first thing a client
    interview would expose). Copy is Scott's to sharpen.
*@

<section class="section--lede">
    <div class="container">
        <p class="topper">Web and application developer</p>
        <h1 class="header">Building .NET applications and nopCommerce stores</h1>
        <p class="text lede__text">
            I've built and maintained .NET applications, nopCommerce stores and business
            websites, a lot of it inside agencies. The projects and the writing here are a
            record of that work.
        </p>
    </div>
</section>

@* Services section hidden while not in use. Restore when needed. *@

@* Selected work section hidden while portfolio is not in use. Restore when needed. *@

@if (Model.RecentPosts.Count > 0)
{
    <section class="section--alt">
        <div class="container">
            <p class="topper">Blog</p>
            <h2 class="title">Selected reading</h2>

            <ul class="cards">
                @foreach (var post in Model.RecentPosts)
                {
                    @* h3: the section h2 above the grid already occupies level 2, same as the
                       work cards, so the outline stays intact. *@
                    <partial name="_PostCard" model="@(new PostCardModel
                            {
                                Post = post,
                                HeadingLevel = 3
                            })" />
                }
            </ul>

            <p class="cards__more">
                <a asp-controller="Blog" asp-action="Index">Read the blog</a>
            </p>
        </div>
    </section>
}
