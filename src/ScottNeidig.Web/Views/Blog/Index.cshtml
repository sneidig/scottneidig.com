@using ScottNeidig.Web.Models
@model BlogListViewModel

@{
    // Toggle links keep the current topic (Index vs Category + slug) and just flip the view.
    // Server-rendered, so no JS.
    var listRoute = Model.IsFiltered
        ? Url.Action("Category", new { slug = Model.SelectedTopic!.Slug, view = "list" })
        : Url.Action("Index", new { view = "list" });
    var gridRoute = Model.IsFiltered
        ? Url.Action("Category", new { slug = Model.SelectedTopic!.Slug, view = "grid" })
        : Url.Action("Index", new { view = "grid" });
}

<section class="section--lede">
    <div class="container">
        <p class="topper">Blog</p>
        <h1 class="header">@(Model.IsFiltered ? Model.SelectedTopic!.Name : "Writing")</h1>
        <p class="text lede__text">
            @if (Model.IsFiltered)
            {
                <text>Posts on @Model.SelectedTopic!.Name.</text>
            }
            else
            {
                <text>Notes on nopCommerce, .NET, and building for the web.</text>
            }
        </p>

        @if (Model.Topics.Count > 0)
        {
            <nav class="filters" aria-label="Filter by topic">
                <a class="filter @(Model.IsFiltered ? "" : "filter--on")"
                   asp-action="Index"
                   aria-current="@(Model.IsFiltered ? null : "page")">All</a>

                @foreach (var topic in Model.Topics)
                {
                    var on = Model.SelectedTopic?.Slug == topic.Slug;

                    <a class="filter @(on ? "filter--on" : "")"
                       asp-action="Category"
                       asp-route-slug="@topic.Slug"
                       aria-current="@(on ? "page" : null)">@topic.Name</a>
                }
            </nav>
        }

        @if (Model.Posts.Count == 0)
        {
            <p class="text">No posts yet. Check back soon.</p>
        }
        else
        {
            <div class="view-toggle" role="group" aria-label="Layout">
                <a class="view-toggle__option @(Model.IsGrid ? "" : "view-toggle__option--on")"
                   href="@listRoute" aria-current="@(Model.IsGrid ? null : "true")">List</a>
                <a class="view-toggle__option @(Model.IsGrid ? "view-toggle__option--on" : "")"
                   href="@gridRoute" aria-current="@(Model.IsGrid ? "true" : null)">Grid</a>
            </div>

            @if (Model.IsGrid)
            {
                <ul class="cards">
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="_PostCard" model="post" />
                    }
                </ul>
            }
            else
            {
                <ul class="post-rows">
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="_PostRow" model="post" />
                    }
                </ul>
            }
        }
    </div>
</section>
