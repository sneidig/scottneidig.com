@*
    Writing on this service's topic: published posts in the assigned category. Renders nothing
    when there are none, so a service with no matching posts shows no empty section.
*@
@using ScottNeidig.Web.Models
@model ServicePageModel

@if (Model.HasPosts)
{
    <section>
        <div class="container">
            <p class="topper">Writing</p>
            <h2 class="title">Related reading</h2>

            @* Cards, so they match the project cards above with a thumbnail and category tag. *@
            <ul class="cards">
                @foreach (var post in Model.Posts)
                {
                    <partial name="_PostCard" model="post" />
                }
            </ul>
        </div>
    </section>
}
