@*
    One post in the blog grid: hero thumbnail (if the post has one), category tag, title, date,
    excerpt. The whole card is one link, one tab stop per post. Reuses the project card's classes.
*@
@using Microsoft.Extensions.Options
@using ScottNeidig.Web.Configuration
@using ScottNeidig.Web.Models
@model PostCardModel
@inject IOptions<ImageOptions> ImageConfig

@{
    var post = Model.Post;
    var folder = ImageConfig.Value.UploadFolder;
    var heroUrl = post.HeroImage is null ? null : $"/{folder}/blog/{post.Slug}/{post.HeroImage}";
}

<li class="card">
    <a class="card__link" asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug">
        @if (heroUrl is not null)
        {
            @* Blog heroes are usually SVG diagrams, served straight, not through the photo
               pipeline. Lazy since the grid is below the fold. *@
            <div class="card__media">
                <img src="@heroUrl" alt="" loading="lazy" decoding="async" />
            </div>
        }

        <div class="card__body">
            @if (post.CategoryName is not null)
            {
                <p class="card__category">@post.CategoryName</p>
            }

            @* Switch rather than a string tag name, same reasoning as _ProjectCard: the
               level depends on what heading sits above the grid. *@
            @switch (Model.HeadingLevel)
            {
                case 3:
                    <h3 class="card__title">@post.Title</h3>
                    break;
                default:
                    <h2 class="card__title">@post.Title</h2>
                    break;
            }

            @if (post.PublishedUtc is { } published)
            {
                <p class="card__meta">@published.ToString("d MMM yyyy")</p>
            }

            @if (!string.IsNullOrWhiteSpace(post.Excerpt))
            {
                <p class="card__text">@post.Excerpt</p>
            }
        </div>
    </a>
</li>
